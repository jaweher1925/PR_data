+    #[test]
+    fn test_manager_updates_and_removes_multiple_indexes() {
+        let manager = IndexManager::new();
+
+        for (name, index_type) in [
+            ("hash_index", IndexType::Hash),
+            ("btree_index", IndexType::BTree),
+        ] {
+            manager
+                .create_index(IndexConfig {
+                    name: name.to_owned(),
+                    index_type,
+                    unique: false,
+                    filter: None,
+                })
+                .unwrap();
+        }
+
+        manager.update_indexes("key", None, "old").unwrap();
+        manager
+            .update_indexes("key", Some("old"), "new")
+            .unwrap();
+
+        for name in ["hash_index", "btree_index"] {
+            let index = manager.get_index(name).unwrap();
+            assert!(index
+                .find_exact(&IndexValue::String("old".to_owned()))
+                .unwrap()
+                .is_empty());
+            assert_eq!(
+                index
+                    .find_exact(&IndexValue::String("new".to_owned()))
+                    .unwrap(),
+                HashSet::from(["key".to_owned()])
+            );
+        }
+
+        manager.remove_from_indexes("key", "new").unwrap();
+
+        for name in ["hash_index", "btree_index"] {
+            assert!(manager
+                .get_index(name)
+                .unwrap()
+                .find_exact(&IndexValue::String("new".to_owned()))
+                .unwrap()
+                .is_empty());
+        }
