+/// An index value in the internal data structures.
+///
+/// Values supplied directly to [`SecondaryIndex::insert`] remain owned, while
+/// values fanned out by [`IndexManager`] are reference counted. This lets all
+/// managed indexes share one immutable value without changing the public
+/// [`IndexValue`] API or adding overhead to direct insertions.
+#[derive(Clone)]
+enum StoredIndexValue {
+    Owned(IndexValue),
+    Shared(Arc<IndexValue>),
+}
+
+impl StoredIndexValue {
+    fn as_value(&self) -> &IndexValue {
+        match self {
+            Self::Owned(value) => value,
+            Self::Shared(value) => value,
+        }
+    }
+}
+
+impl Borrow<IndexValue> for StoredIndexValue {
+    fn borrow(&self) -> &IndexValue {
+        self.as_value()
+    }
+}
+
+impl fmt::Debug for StoredIndexValue {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        self.as_value().fmt(formatter)
+    }
+}
+
+impl PartialEq for StoredIndexValue {
+    fn eq(&self, other: &Self) -> bool {
+        self.as_value() == other.as_value()
+    }
+}
+
+impl Eq for StoredIndexValue {}
+
+impl PartialOrd for StoredIndexValue {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl Ord for StoredIndexValue {
+    fn cmp(&self, other: &Self) -> Ordering {
+        self.as_value().cmp(other.as_value())
+    }
+}
+
+impl Hash for StoredIndexValue {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.as_value().hash(state);
+    }
+}
+
+/// A primary key stored in a secondary index.
+///
+/// Direct inserts retain the caller's `String`. Managed inserts use the shared
+/// form so the key's bytes are allocated only once, regardless of index count.
+#[derive(Clone)]
+enum StoredKey {
+    Owned(String),
+    Shared(Arc<str>),
+}
+
+impl StoredKey {
+    fn as_str(&self) -> &str {
+        match self {
+            Self::Owned(key) => key,
+            Self::Shared(key) => key,
+        }
+    }
+}
+
+impl Borrow<str> for StoredKey {
+    fn borrow(&self) -> &str {
+        self.as_str()
+    }
+}
+
+impl fmt::Debug for StoredKey {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        self.as_str().fmt(formatter)
+    }
+}
+
+impl PartialEq for StoredKey {
+    fn eq(&self, other: &Self) -> bool {
+        self.as_str() == other.as_str()
+    }
+}
+
+impl Eq for StoredKey {}
+
+impl Hash for StoredKey {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.as_str().hash(state);
+    }
+}
