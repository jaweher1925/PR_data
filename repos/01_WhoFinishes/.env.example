# Copy to .env and fill in only what the step you run needs.
# Reproduction path A (pytest over the committed digests) needs NO credentials.

# GitHub REST API token — human-cohort enrichment and net-diff fetching.
GITHUB_TOKEN=<TEST>

# Anthropic API key — only for a fresh live run of the LLM judge.
# The published judge run is pinned in data/judge/ and replays without a key.
ANTHROPIC_API_KEY=<TEST>
